{
  "vaultPath": "/absolute/path/to/your/ObsidianVault",
  "mappings": [
    {
      "obsidianFolder": "Blog/Drafts",
      "blogCategory": "frontend",
      "direction": "bidirectional"
    },
    {
      "obsidianFolder": "Blog/Published",
      "blogCategory": "classics",
      "direction": "bidirectional"
    }
  ],
  "obsidianPublishFolder": "Blog/Published",
  "obsidianBlogRoot": "Blogs",
  "ignore": [".obsidian", "Templates", "Daily"],
  "syncFrontmatter": true,
  "wikilinkMode": "markdown"
}
